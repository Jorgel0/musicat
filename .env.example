# Copy this file to .env and fill in real values before `docker-compose up`.
# .env is gitignored — never commit it.

# Soulseek network login. This account is created automatically the first
# time slskd connects with it — there's no separate sign-up, just pick a
# username that isn't already taken on the network.
SLSKD_SLSK_USERNAME=
SLSKD_SLSK_PASSWORD=

# Shared secret between slskd and Musicat Server: slskd requires it on every
# REST API request, and Musicat Server presents it when it talks to slskd.
# Generate one with, e.g.:
#   openssl rand -hex 32
SLSKD_API_KEY=

# Optional: only needed if the Musicat app will reach this stack over the
# real network (e.g. it's running on a different machine, a NAS or VPS)
# rather than on the same machine as the app. Leave unset otherwise --
# Musicat Server rejects every request that doesn't arrive from its own
# machine unless this is set and the caller presents the same value.
# Generate one the same way as SLSKD_API_KEY above, and configure this same
# value in the app's Musicat Server settings.
MUSICAT_APP_API_KEY=
